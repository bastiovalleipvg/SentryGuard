{
  "name": "sentryguard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "certs": "dotnet dev-certs https --export-path ./certs/localhost.pem --format Pem --no-password",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
