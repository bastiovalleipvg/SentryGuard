# ==========================================
# Variables de Entorno - SentryGuard
# Copia este archivo a .env y define los valores locales.
# NUNCA subas el archivo .env al repositorio.
# ==========================================

# Contraseña del usuario SA de SQL Server
SA_PASSWORD=SentryGuard2026!

# Cadena de conexión para la API
ConnectionStrings__DefaultConnection=Server=db,1433;Database=SentryGuard;User Id=sa;Password=SentryGuard2026!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Configuración de Seguridad JWT
Jwt__Key=ClaveSecretaDeDesarrolloSentryGuardDeAlMenos64BytesDeLargoSegura!
Jwt__Issuer=https://api.sentryguard.cl
Jwt__Audience=https://sentryguard.cl

# Entorno de ejecución
ASPNETCORE_ENVIRONMENT=Development

# Configuración de Inteligencia Artificial (Opcional - Si está vacía usa AsistenteSimulado)
IA__ApiKey=
IA__Modelo=gemini-2.5-flash
