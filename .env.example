# ==========================================
# Variables de SentryGuard para docker compose
# Copia este archivo a .env y completa los valores (o ejecuta ./scripts/generar-env.ps1, que lo hace por ti
# con claves aleatorias). .env esta excluido del repositorio: NUNCA lo subas.
# ==========================================

# Contraseña del usuario SA de SQL Server. Minimo 12 caracteres con mayusculas, minusculas y numeros.
# Evita ; = " $ y espacios (van dentro de la cadena de conexion).
SA_PASSWORD=

# Clave de firma de los JWT. Aleatoria, de al menos 64 caracteres.
JWT_KEY=

# Servicio de IA (opcional). Si IA_API_KEY esta vacia la API usa el asistente simulado.
IA_API_KEY=
IA_MODELO=gemini-2.5-flash

# Opcionales
# WEB_PORT=8088                    # puerto en que se publica la aplicacion
# DOCUMENTACION_HABILITADA=true    # OpenAPI y Scalar en /scalar/v1; en produccion real, false
# ASPNETCORE_ENVIRONMENT=Production
# DB_HOST_PORT=14333               # solo compose.override.yaml: SQL Server en 127.0.0.1
