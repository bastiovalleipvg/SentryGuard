# Variables de configuracion sensibles de la API SentryGuard.
# ASP.NET Core NO lee este archivo automaticamente: es una plantilla de referencia.
#
# En desarrollo se configuran con User Secrets (fuera del repositorio):
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<cadena>"
#   dotnet user-secrets set "Jwt:Key" "<clave aleatoria de al menos 32 caracteres>"
#
# En otros entornos se definen como variables de entorno del sistema o del hosting
# (el doble guion bajo equivale a ':' en la jerarquia de configuracion):

ConnectionStrings__DefaultConnection=Server=TU_SERVIDOR\TU_INSTANCIA;Database=SentryGuardDB;Trusted_Connection=True;TrustServerCertificate=True;
Jwt__Key=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Origenes permitidos por CORS (no sensibles; tambien estan en appsettings.json)
Cors__AllowedOrigins__0=https://localhost:5173
Cors__AllowedOrigins__1=https://localhost:4173
